{
  "name": "cookie-pulse",
  "version": "1.0.0",
  "description": "Cookie Pulse — a live on-chain terminal for Cookie Chain (SVM). Real-time telemetry, wallet inspector, pool enumeration, and COOK transactions. Nightly wallet supported.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "clean-start": "env -i PATH=/usr/bin:/bin HOME=$HOME LANG=C.UTF-8 node server.js"
  },
  "keywords": [
    "cookie-chain",
    "solana",
    "svm",
    "web3",
    "dapp",
    "nightly",
    "dashboard",
    "cookieswap",
    "cookiebox"
  ],
  "author": "skencono",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skencono/cookie-pulse.git"
  },
  "homepage": "https://github.com/skencono/cookie-pulse#readme",
  "dependencies": {
    "express": "^4.21.2",
    "@solana/web3.js": "^1.95.4",
    "@solana/spl-token": "^0.4.9",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.2.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
